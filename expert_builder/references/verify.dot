// verify.dot -- deterministic reference-repository integrity guard for expert_builder.
//
// This closed-package helper reads only target-owned preparation metadata and
// reference Git-visible state. It never repairs, refreshes, or writes a reference.
digraph verify_references {
  graph [
    label="Verify trusted reference repository integrity",
    goal="Fail closed when a prepared reference worktree or its Git-visible state differs from its recorded baseline.",
    rankdir="LR",
    default_max_retry="1",
    default_fidelity="truncate"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit [shape=Msquare, label="Exit"];

  VerifyReferences [
    shape=parallelogram,
    label="Verify reference baselines",
    tool_env="reference_manifest_digest",
    parse_json="true",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport hashlib\nimport json\nimport os\nimport stat\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nMAX_ERROR = 600\nDIMENSIONS = ('index', 'tracked_worktree', 'untracked', 'submodules')\nCHANGED_NAMES = ('head', 'ref', *DIMENSIONS, 'digest')\n\ndef fail(message):\n    text = str(message).replace(chr(10), ' ').strip()\n    print('ERROR: ' + text[:MAX_ERROR], file=sys.stderr)\n    raise SystemExit(1)\n\ndef git(path, *args, check=True):\n    try:\n        return subprocess.run(['git', '-C', os.fspath(path), *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)\n    except OSError as error:\n        fail('cannot launch Git for ' + os.fspath(path) + ': ' + str(error))\n\ndef git_output(path, *args):\n    result = git(path, *args, check=False)\n    if result.returncode:\n        detail = result.stderr.decode(errors='replace').strip()\n        fail('Git command failed for ' + os.fspath(path) + ': ' + detail)\n    return result.stdout\n\ndef git_detail(result):\n    return result.stderr.decode(errors='replace').strip() or 'no Git diagnostic'\n\ndef worktree_root(raw_path, label):\n    supplied = Path(raw_path).expanduser()\n    try:\n        exists = supplied.exists()\n        is_directory = supplied.is_dir()\n    except OSError as error:\n        fail('cannot inspect ' + label + ' path ' + os.fspath(supplied) + ': ' + str(error))\n    if not exists:\n        fail(label + ' path does not exist: ' + os.fspath(supplied))\n    probe = supplied if is_directory else supplied.parent\n    bare = git(probe, 'rev-parse', '--is-bare-repository', check=False)\n    if bare.returncode:\n        fail(label + ' is not inside a Git worktree: ' + os.fspath(supplied))\n    if bare.stdout.strip() == b'true':\n        fail(label + ' is a bare Git repository: ' + os.fspath(supplied))\n    root = git(probe, 'rev-parse', '--show-toplevel', check=False)\n    if root.returncode:\n        fail(label + ' is not inside a Git worktree: ' + os.fspath(supplied))\n    try:\n        return Path(root.stdout.decode(errors='surrogateescape').strip()).resolve(strict=True)\n    except OSError as error:\n        fail('cannot canonicalize ' + label + ' worktree root: ' + str(error))\n\ndef digest_bytes(*chunks):\n    digest = hashlib.sha256()\n    for chunk in chunks:\n        digest.update(len(chunk).to_bytes(8, 'big'))\n        digest.update(chunk)\n    return digest.hexdigest()\n\ndef untracked_digest(root, reference_id):\n    listing = git_output(root, 'ls-files', '--others', '--exclude-standard', '-z')\n    entries = []\n    for encoded in filter(None, listing.split(bytes([0]))):\n        relative = os.fsdecode(encoded)\n        item = root / relative\n        try:\n            metadata = item.lstat()\n            kind = stat.S_IFMT(metadata.st_mode)\n            mode = stat.S_IMODE(metadata.st_mode)\n            if stat.S_ISREG(metadata.st_mode):\n                payload = item.read_bytes()\n            elif stat.S_ISLNK(metadata.st_mode):\n                payload = os.fsencode(os.readlink(item))\n            else:\n                payload = b''\n        except OSError as error:\n            fail('cannot read reference ' + reference_id + ' path ' + os.fspath(item) + ' while fingerprinting: ' + str(error))\n        entries.append((encoded, kind, mode, payload))\n    entries.sort(key=lambda entry: entry[0])\n    chunks = []\n    for encoded, kind, mode, payload in entries:\n        chunks.extend((encoded, str(kind).encode(), str(mode).encode(), payload))\n    return digest_bytes(*chunks)\n\ndef head_and_ref(root):\n    ref_result = git(root, 'symbolic-ref', '-q', 'HEAD', check=False)\n    if ref_result.returncode == 0:\n        ref = ref_result.stdout.decode(errors='replace').strip()\n        if not ref:\n            fail('Git symbolic-ref returned an empty ref for ' + os.fspath(root))\n    elif ref_result.returncode == 1:\n        ref = 'DETACHED'\n    else:\n        fail('Git symbolic-ref failed for ' + os.fspath(root) + ': ' + git_detail(ref_result))\n    head_result = git(root, 'rev-parse', '--verify', 'HEAD', check=False)\n    if head_result.returncode == 0:\n        head = head_result.stdout.decode(errors='replace').strip()\n        if not head:\n            fail('Git rev-parse returned an empty HEAD for ' + os.fspath(root))\n        return head, ref\n    if ref == 'DETACHED':\n        fail('Git HEAD is invalid rather than detached for ' + os.fspath(root) + ': ' + git_detail(head_result))\n    exists_result = git(root, 'show-ref', '--verify', '--quiet', ref, check=False)\n    if exists_result.returncode == 1:\n        return 'UNBORN', ref\n    if exists_result.returncode == 0:\n        fail('Git HEAD cannot be resolved although its symbolic ref exists for ' + os.fspath(root) + ': ' + git_detail(head_result))\n    fail('Git could not verify symbolic ref ' + ref + ' for ' + os.fspath(root) + ': ' + git_detail(exists_result))\n\ndef baseline(root, reference_id):\n    head, ref = head_and_ref(root)\n    index = digest_bytes(git_output(root, 'ls-files', '--stage', '-z'))\n    tracked_worktree = digest_bytes(\n        git_output(root, 'status', '--porcelain=v2', '-z', '--untracked-files=no', '--ignore-submodules=none'),\n        git_output(root, 'diff', '--binary', '--full-index', '--no-ext-diff'),\n    )\n    dimensions = {\n        'index': index,\n        'tracked_worktree': tracked_worktree,\n        'untracked': untracked_digest(root, reference_id),\n        'submodules': digest_bytes(git_output(root, 'submodule', 'status', '--recursive')),\n    }\n    canonical = json.dumps({'head': head, 'ref': ref, 'dimensions': dimensions}, sort_keys=True, separators=(',', ':')).encode()\n    return {'head': head, 'ref': ref, 'digest': hashlib.sha256(canonical).hexdigest(), 'dimensions': dimensions}\n\ndef secure_manifest(target):\n    directory = target / '.ai'\n    expected = os.path.abspath(os.fspath(directory))\n    directory_fd = None\n    manifest_fd = None\n    try:\n        metadata = directory.lstat()\n        if stat.S_ISLNK(metadata.st_mode):\n            fail('target artifact path is a symlink: ' + expected)\n        if not stat.S_ISDIR(metadata.st_mode):\n            fail('target artifact path is not a real directory: ' + expected)\n        physical = os.path.realpath(expected)\n        common = os.path.commonpath([os.fspath(target), physical])\n        if common != os.fspath(target) or physical != expected:\n            fail('target artifact directory escapes canonical target: ' + expected + ' -> ' + physical)\n        flags = os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0) | getattr(os, 'O_NOFOLLOW', 0)\n        directory_fd = os.open(directory, flags)\n        opened = os.fstat(directory_fd)\n        current = directory.lstat()\n        if not stat.S_ISDIR(opened.st_mode) or (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino):\n            fail('target artifact directory changed during secure open: ' + expected)\n        file_flags = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0)\n        manifest_fd = os.open('references.json', file_flags, dir_fd=directory_fd)\n        manifest_stat = os.fstat(manifest_fd)\n        manifest_path_stat = (directory / 'references.json').lstat()\n        if stat.S_ISLNK(manifest_path_stat.st_mode):\n            fail('target reference manifest is a symlink: ' + os.fspath(directory / 'references.json'))\n        if not stat.S_ISREG(manifest_stat.st_mode) or (manifest_stat.st_dev, manifest_stat.st_ino) != (manifest_path_stat.st_dev, manifest_path_stat.st_ino):\n            fail('target reference manifest changed during secure open: ' + os.fspath(directory / 'references.json'))\n        chunks = []\n        while True:\n            chunk = os.read(manifest_fd, 65536)\n            if not chunk:\n                break\n            chunks.append(chunk)\n        return b''.join(chunks)\n    except SystemExit:\n        raise\n    except (OSError, ValueError) as error:\n        fail('cannot securely read target reference manifest ' + os.fspath(directory / 'references.json') + ': ' + str(error))\n    finally:\n        for descriptor in (manifest_fd, directory_fd):\n            if descriptor is not None:\n                try:\n                    os.close(descriptor)\n                except OSError:\n                    pass\n\ndef is_digest(value):\n    return isinstance(value, str) and len(value) == 64 and all(character in '0123456789abcdef' for character in value)\n\ndef manifest_references(raw, target):\n    try:\n        document = json.loads(raw.decode('utf-8'))\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        fail('target reference manifest is not valid UTF-8 JSON: ' + str(error))\n    if not isinstance(document, dict) or set(document) != {'schema_version', 'target_root', 'references'}:\n        fail('target reference manifest has wrong schema')\n    if not (type(document['schema_version']) is int and document['schema_version'] == 1) or document['target_root'] != os.fspath(target) or not isinstance(document['references'], list):\n        fail('target reference manifest has wrong schema or target_root mismatch')\n    seen = set()\n    entries = []\n    for position, entry in enumerate(document['references']):\n        if not isinstance(entry, dict) or set(entry) != {'id', 'path', 'use_in_validation', 'baseline'}:\n            fail('target reference manifest entry ' + str(position) + ' has wrong schema')\n        identifier = entry['id']\n        path = entry['path']\n        snapshot = entry['baseline']\n        if not isinstance(identifier, str) or not identifier or identifier in seen or not isinstance(path, str) or not isinstance(entry['use_in_validation'], bool):\n            fail('target reference manifest entry ' + str(position) + ' has malformed identity')\n        if not isinstance(snapshot, dict) or set(snapshot) != {'head', 'ref', 'digest', 'dimensions'} or not isinstance(snapshot['head'], str) or not isinstance(snapshot['ref'], str) or not is_digest(snapshot['digest']):\n            fail('target reference manifest baseline is malformed for ' + identifier)\n        dimensions = snapshot['dimensions']\n        if not isinstance(dimensions, dict) or set(dimensions) != set(DIMENSIONS) or not all(is_digest(dimensions[name]) for name in DIMENSIONS):\n            fail('target reference manifest baseline dimensions are malformed for ' + identifier)\n        seen.add(identifier)\n        entries.append(entry)\n    return entries\n\ndef verify_reference(entry):\n    identifier = entry['id']\n    stored_path = entry['path']\n    root = worktree_root(stored_path, 'reference ' + identifier)\n    if os.fspath(root) != stored_path:\n        fail('reference ' + identifier + ' moved from recorded canonical path: ' + stored_path)\n    current = baseline(root, identifier)\n    previous = entry['baseline']\n    changed = []\n    for name in CHANGED_NAMES:\n        if name in DIMENSIONS:\n            before = previous['dimensions'][name]\n            after = current['dimensions'][name]\n        else:\n            before = previous[name]\n            after = current[name]\n        if before != after:\n            changed.append(name)\n    if changed:\n        fail('reference ' + identifier + ' integrity changed: ' + ','.join(sorted(changed)))\n\ntarget = worktree_root(Path.cwd(), 'target')\nexpected_manifest_digest = os.environ.get('REFERENCE_MANIFEST_DIGEST', '').strip()\nif not is_digest(expected_manifest_digest):\n    fail('reference manifest digest missing or malformed in trusted pipeline context')\nmanifest_raw = secure_manifest(target)\nactual_manifest_digest = hashlib.sha256(manifest_raw).hexdigest()\nif actual_manifest_digest != expected_manifest_digest:\n    fail('reference manifest digest mismatch: prepared bytes differ from the trusted pipeline context')\nentries = manifest_references(manifest_raw, target)\nfor entry in entries:\n    try:\n        verify_reference(entry)\n    except SystemExit:\n        raise\n    except OSError as error:\n        fail('cannot verify reference ' + str(entry.get('id', '<unknown>')) + ': ' + str(error))\nprint(json.dumps({'reference_integrity_state': 'unchanged'}, separators=(',', ':')))\nPYEOF"
  ];

  Start -> VerifyReferences -> Exit;
}