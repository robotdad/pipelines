// prepare.dot -- deterministic reference-repository preparation for expert_builder.
//
// The graph is intentionally a single mechanical step. It accepts optional JSON text via
// REFERENCES, validates and fingerprints already-present Git worktrees without modifying them,
// and writes target-owned metadata only. Its parse_json output publishes reference_state.

digraph prepare_references {
  graph [
    label="Prepare trusted reference repositories",
    goal="Validate optional reference worktrees, record Git-visible baselines, and publish target-owned reference context without modifying references.",
    rankdir="LR",
    default_max_retry="1",
    default_fidelity="truncate"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit [shape=Msquare, label="Exit"];

  PrepareReferences [
    shape=parallelogram,
    label="Prepare reference baselines",
    tool_env="references",
    parse_json="true",
    tool_command="#!/bin/sh\nset -e\npython3 - <<'PYEOF'\nimport hashlib\nimport json\nimport os\nimport secrets\nimport stat\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nMAX_ERROR = 600\n\ndef fail(message):\n    text = str(message).replace(chr(10), ' ').strip()\n    print('ERROR: ' + text[:MAX_ERROR], file=sys.stderr)\n    raise SystemExit(1)\n\ndef git(path, *args, check=True):\n    try:\n        return subprocess.run(['git', '-C', os.fspath(path), *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)\n    except OSError as error:\n        fail('cannot launch Git for ' + os.fspath(path) + ': ' + str(error))\n\ndef git_output(path, *args):\n    result = git(path, *args, check=False)\n    if result.returncode:\n        detail = result.stderr.decode(errors='replace').strip()\n        fail('Git command failed for ' + os.fspath(path) + ': ' + detail)\n    return result.stdout\n\ndef worktree_root(raw_path, label):\n    supplied = Path(raw_path).expanduser()\n    try:\n        exists = supplied.exists()\n        is_directory = supplied.is_dir()\n    except OSError as error:\n        fail('cannot inspect ' + label + ' path ' + os.fspath(supplied) + ': ' + str(error))\n    if not exists:\n        fail(label + ' path does not exist: ' + os.fspath(supplied))\n    probe = supplied if is_directory else supplied.parent\n    bare = git(probe, 'rev-parse', '--is-bare-repository', check=False)\n    if bare.returncode:\n        fail(label + ' is not inside a Git worktree: ' + os.fspath(supplied))\n    if bare.stdout.strip() == b'true':\n        fail(label + ' is a bare Git repository: ' + os.fspath(supplied))\n    root = git(probe, 'rev-parse', '--show-toplevel', check=False)\n    if root.returncode:\n        fail(label + ' is not inside a Git worktree: ' + os.fspath(supplied))\n    try:\n        return Path(root.stdout.decode(errors='surrogateescape').strip()).resolve(strict=True)\n    except OSError as error:\n        fail('cannot canonicalize ' + label + ' worktree root: ' + str(error))\n\ndef digest_bytes(*chunks):\n    digest = hashlib.sha256()\n    for chunk in chunks:\n        digest.update(len(chunk).to_bytes(8, 'big'))\n        digest.update(chunk)\n    return digest.hexdigest()\n\ndef untracked_digest(root, reference_id):\n    listing = git_output(root, 'ls-files', '--others', '--exclude-standard', '-z')\n    entries = []\n    for encoded in filter(None, listing.split(bytes([0]))):\n        relative = os.fsdecode(encoded)\n        item = root / relative\n        try:\n            metadata = item.lstat()\n            kind = stat.S_IFMT(metadata.st_mode)\n            mode = stat.S_IMODE(metadata.st_mode)\n            if stat.S_ISREG(metadata.st_mode):\n                payload = item.read_bytes()\n            elif stat.S_ISLNK(metadata.st_mode):\n                payload = os.fsencode(os.readlink(item))\n            else:\n                payload = b''\n        except OSError as error:\n            fail('cannot read reference ' + reference_id + ' path ' + os.fspath(item) + ' while fingerprinting: ' + str(error))\n        entries.append((encoded, kind, mode, payload))\n    entries.sort(key=lambda entry: entry[0])\n    chunks = []\n    for encoded, kind, mode, payload in entries:\n        chunks.extend((encoded, str(kind).encode(), str(mode).encode(), payload))\n    return digest_bytes(*chunks)\n\ndef git_detail(result):\n    return result.stderr.decode(errors='replace').strip() or 'no Git diagnostic'\n\ndef head_and_ref(root):\n    ref_result = git(root, 'symbolic-ref', '-q', 'HEAD', check=False)\n    if ref_result.returncode == 0:\n        ref = ref_result.stdout.decode(errors='replace').strip()\n        if not ref:\n            fail('Git symbolic-ref returned an empty ref for ' + os.fspath(root))\n    elif ref_result.returncode == 1:\n        ref = 'DETACHED'\n    else:\n        fail('Git symbolic-ref failed for ' + os.fspath(root) + ': ' + git_detail(ref_result))\n\n    head_result = git(root, 'rev-parse', '--verify', 'HEAD', check=False)\n    if head_result.returncode == 0:\n        head = head_result.stdout.decode(errors='replace').strip()\n        if not head:\n            fail('Git rev-parse returned an empty HEAD for ' + os.fspath(root))\n        return head, ref\n\n    if ref == 'DETACHED':\n        fail('Git HEAD is invalid rather than detached for ' + os.fspath(root) + ': ' + git_detail(head_result))\n\n    exists_result = git(root, 'show-ref', '--verify', '--quiet', ref, check=False)\n    if exists_result.returncode == 1:\n        return 'UNBORN', ref\n    if exists_result.returncode == 0:\n        fail('Git HEAD cannot be resolved although its symbolic ref exists for ' + os.fspath(root) + ': ' + git_detail(head_result))\n    fail('Git could not verify symbolic ref ' + ref + ' for ' + os.fspath(root) + ': ' + git_detail(exists_result))\n\ndef baseline(root, reference_id):\n    head, ref = head_and_ref(root)\n    index = digest_bytes(git_output(root, 'ls-files', '--stage', '-z'))\n    tracked_worktree = digest_bytes(\n        git_output(root, 'status', '--porcelain=v2', '-z', '--untracked-files=no', '--ignore-submodules=none'),\n        git_output(root, 'diff', '--binary', '--full-index', '--no-ext-diff'),\n    )\n    dimensions = {\n        'index': index,\n        'tracked_worktree': tracked_worktree,\n        'untracked': untracked_digest(root, reference_id),\n        'submodules': digest_bytes(git_output(root, 'submodule', 'status', '--recursive')),\n    }\n    canonical = json.dumps({'head': head, 'ref': ref, 'dimensions': dimensions}, sort_keys=True, separators=(',', ':')).encode()\n    return {'head': head, 'ref': ref, 'digest': hashlib.sha256(canonical).hexdigest(), 'dimensions': dimensions}\n\ndef overlaps(left, right):\n    left_root = os.path.abspath(os.fspath(left))\n    right_root = os.path.abspath(os.fspath(right))\n    try:\n        common = os.path.commonpath([left_root, right_root])\n    except (OSError, ValueError) as error:\n        fail('cannot compare canonical worktree roots ' + left_root + ' and ' + right_root + ': ' + str(error))\n    return common == left_root or common == right_root\n\ndef open_artifact_directory(target):\n    path = target / '.ai'\n    expected = os.path.abspath(os.fspath(path))\n    directory_fd = None\n    try:\n        try:\n            metadata = path.lstat()\n        except FileNotFoundError:\n            os.mkdir(path, 0o700)\n            metadata = path.lstat()\n        if stat.S_ISLNK(metadata.st_mode):\n            fail('target artifact path is a symlink: ' + expected)\n        if not stat.S_ISDIR(metadata.st_mode):\n            fail('target artifact path is not a real directory: ' + expected)\n        physical = os.path.realpath(expected)\n        common = os.path.commonpath([os.fspath(target), physical])\n        if common != os.fspath(target) or physical != expected:\n            fail('target artifact directory escapes canonical target: ' + expected + ' -> ' + physical)\n        flags = os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0) | getattr(os, 'O_NOFOLLOW', 0)\n        directory_fd = os.open(path, flags)\n        opened = os.fstat(directory_fd)\n        current = path.lstat()\n        if not stat.S_ISDIR(opened.st_mode) or (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino):\n            fail('target artifact directory changed during secure open: ' + expected)\n        return path, directory_fd\n    except SystemExit:\n        if directory_fd is not None:\n            os.close(directory_fd)\n        raise\n    except (OSError, ValueError) as error:\n        if directory_fd is not None:\n            try:\n                os.close(directory_fd)\n            except OSError:\n                pass\n        fail('cannot secure target artifact directory ' + expected + ': ' + str(error))\n\ndef atomic_write(directory_fd, directory_path, filename, text):\n    temporary = '.' + filename + '.' + secrets.token_hex(16) + '.tmp'\n    file_fd = None\n    try:\n        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0)\n        file_fd = os.open(temporary, flags, 0o600, dir_fd=directory_fd)\n        with os.fdopen(file_fd, 'w', encoding='utf-8') as handle:\n            file_fd = None\n            handle.write(text)\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temporary, filename, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)\n        os.fsync(directory_fd)\n    except OSError as error:\n        if file_fd is not None:\n            try:\n                os.close(file_fd)\n            except OSError:\n                pass\n        try:\n            os.unlink(temporary, dir_fd=directory_fd)\n        except OSError:\n            pass\n        fail('cannot atomically write target artifact ' + os.fspath(directory_path / filename) + ': ' + str(error))\n\nraw = os.environ.get('REFERENCES')\nif raw is None or not raw.strip():\n    parsed = []\nelse:\n    try:\n        parsed = json.loads(raw)\n    except json.JSONDecodeError as error:\n        fail('references must be valid JSON array text: ' + error.msg)\n    if not isinstance(parsed, list):\n        fail('references must be a JSON array')\n\ntarget = worktree_root(Path.cwd(), 'target')\nreferences = []\nseen_ids = set()\nfor position, entry in enumerate(parsed):\n    if not isinstance(entry, dict):\n        fail('reference entry ' + str(position) + ' must be an object')\n    unknown = set(entry) - {'id', 'path', 'use_in_validation'}\n    if unknown:\n        fail('reference entry ' + str(position) + ' has unknown field: ' + sorted(unknown)[0])\n    identifier = entry.get('id')\n    supplied_path = entry.get('path')\n    if not isinstance(identifier, str) or not identifier.strip():\n        fail('reference entry ' + str(position) + ' id must be a non-empty string')\n    if not isinstance(supplied_path, str) or not supplied_path.strip():\n        fail('reference entry ' + str(position) + ' path must be a non-empty string')\n    use_in_validation = entry.get('use_in_validation', False)\n    if not isinstance(use_in_validation, bool):\n        fail('reference entry ' + str(position) + ' use_in_validation must be boolean')\n    if identifier in seen_ids:\n        fail('duplicate reference id: ' + identifier)\n    root = worktree_root(supplied_path, 'reference ' + identifier)\n    if overlaps(target, root):\n        fail('reference ' + identifier + ' overlaps target worktree')\n    for previous in references:\n        if overlaps(previous['root'], root):\n            fail('reference ' + identifier + ' overlaps reference ' + previous['id'])\n    seen_ids.add(identifier)\n    references.append({'id': identifier, 'root': root, 'use_in_validation': use_in_validation})\n\nprepared = []\nfor reference in references:\n    try:\n        snapshot = baseline(reference['root'], reference['id'])\n    except SystemExit:\n        raise\n    except OSError as error:\n        fail('cannot fingerprint reference ' + reference['id'] + ' at ' + os.fspath(reference['root']) + ': ' + str(error))\n    prepared.append({\n        'id': reference['id'],\n        'path': os.fspath(reference['root']),\n        'use_in_validation': reference['use_in_validation'],\n        'baseline': snapshot,\n    })\n\nartifact_dir, artifact_fd = open_artifact_directory(target)\nmanifest = {'schema_version': 1, 'target_root': os.fspath(target), 'references': prepared}\nmanifest_text = json.dumps(manifest, indent=2, sort_keys=True) + chr(10)\nreference_manifest_digest = hashlib.sha256(manifest_text.encode('utf-8')).hexdigest()\nlines = [\n    '# Reference Repository Context',\n    '',\n    'Authorized target: ' + os.fspath(target),\n    '',\n    'Only the target path ' + os.fspath(target) + ' is the only authorized write and delivery target; only the target may be modified, staged, committed, or delivered.',\n    '',\n    'Reference repositories are trusted read-only inputs. Inspect them for context only; do not modify them.',\n    '',\n    '## References',\n]\nif not prepared:\n    lines.append('- None.')\nfor reference in prepared:\n    role = 'validation dependency' if reference['use_in_validation'] else 'context-only'\n    lines.append('- ' + reference['id'] + ': ' + reference['path'] + ' — ' + role + '.')\ncontext_markdown = chr(10).join(lines) + chr(10)\ntry:\n    atomic_write(artifact_fd, artifact_dir, 'references.json', manifest_text)\n    atomic_write(artifact_fd, artifact_dir, 'reference_context.md', context_markdown)\nfinally:\n    active_error = sys.exc_info()[0] is not None\n    try:\n        os.close(artifact_fd)\n    except OSError as error:\n        if not active_error:\n            fail('cannot close target artifact directory ' + os.fspath(artifact_dir) + ': ' + str(error))\nprint(json.dumps({'reference_state': 'prepared', 'reference_manifest_digest': reference_manifest_digest}, separators=(',', ':')))\nPYEOF"
  ];

  Start -> PrepareReferences -> Exit;
}
