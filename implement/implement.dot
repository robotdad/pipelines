// Pure Attractor implementation-to-PR pipeline.
//
// Package contract:
//   Entrypoint: git+https://github.com/robotdad/pipelines@main#subdirectory=implement/implement.dot
//   Required params: task, test_command
//   Resolve-provided workspace context: workspace_repo (owner/repo)
//   Optional param: branch_name
//
// Shape vocabulary:
//   Mdiamond / Msquare = entry / terminal
//   box                = LLM stage
//   parallelogram      = deterministic shell stage
//
// All transient run evidence belongs in .ai/implement/. Commit explicitly unstages all .ai state.
// The pipeline pushes to an explicit github.com URL, never the hosted Gitea origin.

digraph implement_to_pr {
  graph [
    label="Implement Session-Distilled Task to Verified GitHub PR",
    labelloc="t",
    rankdir="LR",
    goal="$task",
    params="task,test_command,branch_name",
    "param.task"="TextField:longText:Session-distilled implementation task:required",
    "param.test_command"="TextField:shortText:Exact test command:required",
    "param.branch_name"="TextField:shortText:GitHub branch name (optional)",
    default_max_retry=0,
    default_fidelity="truncate",
    max_pipeline_duration="7200s"
  ];

  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];

  Start [shape=Mdiamond, label="Start"];
  Exit [shape=Msquare, label="Verified PR"];
  FailLoud [
    shape=parallelogram,
    label="Fail loud",
    tool_command="#!/bin/sh\nprintf '%s\n' 'Pipeline stopped on an explicit failure path; inspect the preceding stage evidence.' >&2\nexit 1"
  ];

  Implement [
    shape=box,
    label="Implement",
    fidelity="full",
    llm_provider="anthropic",
    llm_model="claude-sonnet-4-6",
    reasoning_effort="high",
    max_agent_turns=80,
    timeout="1800s",
    prompt="You are the implementation engineer in the current repository. Implement this session-distilled task:\n\n$task\n\nRead the repository conventions and the relevant code before changing it. If .ai/implement/review.json exists with verdict 'repair', use its actionable feedback to refine the implementation. Add or update focused tests when the task warrants them, and run focused checks needed to establish the change. Write concise implementation evidence to .ai/implement/implementation.md, including changed files and focused checks run."
  ];

  Test [
    shape=parallelogram,
    label="Run supplied tests",
    tool_env="test_command",
    timeout="1800s",
    tool_command="#!/bin/sh\nset -eu\nmkdir -p .ai/implement\nif [ ! -s .ai/implement/implementation.md ]; then\n  echo 'ERROR: Implement did not write required .ai/implement/implementation.md evidence.' >&2\n  exit 1\nfi\nif [ -z \"${TEST_COMMAND:-}\" ]; then\n  echo 'ERROR: required test_command was not provided.' >&2\n  exit 1\nfi\nprintf '%s\\n' \"$TEST_COMMAND\" > .ai/implement/test-command.txt\nsh -c \"$TEST_COMMAND\" > .ai/implement/test-output.txt 2>&1\nprintf '%s\\n' 'tests_passed' >> .ai/implement/test-output.txt\nprintf '%s\\n' 'tests_passed'"
  ];

  Review [
    shape=box,
    label="Independent review",
    fidelity="full",
    llm_provider="anthropic",
    llm_model="claude-sonnet-4-6",
    reasoning_effort="high",
    max_agent_turns=50,
    timeout="1800s",
    prompt="Independently review the current repository against this session-distilled task:\n\n$task\n\nInspect the implementation, its tests, git diff, .ai/implement/implementation.md, and .ai/implement/test-output.txt. Write .ai/implement/review.json as exactly one JSON object with this schema: {\"verdict\":\"pass\"|\"repair\",\"feedback\":\"...\"}. Use verdict 'pass' only when the task is met and the supplied tests provide the expected evidence. Use verdict 'repair' with concise, actionable feedback when the implementation needs correction."
  ];

  Decide [
    shape=parallelogram,
    label="Classify review deterministically",
    timeout="60s",
    tool_command="#!/bin/sh\nset -eu\nmkdir -p .ai/implement\npython3 - <<'PYEOF'\nimport json\nimport os\nimport sys\n\nreview_path = '.ai/implement/review.json'\nstate_path = '.ai/implement/review-state.json'\ntry:\n    with open(review_path, encoding='utf-8') as handle:\n        review = json.load(handle)\nexcept (OSError, json.JSONDecodeError) as error:\n    print('ERROR: review artifact is missing or invalid: %s' % error, file=sys.stderr)\n    print('review_invalid')\n    raise SystemExit(0)\n\nif not isinstance(review, dict) or set(review) != {'verdict', 'feedback'}:\n    print('ERROR: review artifact must contain only verdict and feedback.', file=sys.stderr)\n    print('review_invalid')\n    raise SystemExit(0)\n\nverdict = review.get('verdict')\nfeedback = review.get('feedback')\nif verdict == 'pass' and isinstance(feedback, str):\n    decision = 'review_pass'\nelif verdict == 'repair' and isinstance(feedback, str) and feedback.strip():\n    try:\n        with open(state_path, encoding='utf-8') as handle:\n            state = json.load(handle)\n    except (OSError, json.JSONDecodeError):\n        state = {}\n    repairs = int(state.get('repairs', 0)) + 1\n    state = {'repairs': repairs, 'last_feedback': feedback}\n    with open(state_path, 'w', encoding='utf-8') as handle:\n        json.dump(state, handle, indent=2)\n        handle.write(chr(10))\n    decision = 'repair' if repairs == 1 else 'repair_exhausted'\nelse:\n    print('ERROR: review verdict must be pass or repair with string feedback.', file=sys.stderr)\n    decision = 'review_invalid'\n\nprint(decision)\nPYEOF"
  ];

  Commit [
    shape=parallelogram,
    label="Commit tested change",
    tool_env="workspace_repo,branch_name",
    timeout="180s",
    tool_command="#!/bin/sh\nset -eu\nmkdir -p .ai/implement\npython3 - <<'PYEOF'\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom datetime import datetime, timezone\n\ngit_env = dict(os.environ)\ngit_env.update({\n    'GIT_CONFIG_GLOBAL': os.devnull,\n    'GIT_CONFIG_NOSYSTEM': '1',\n    'GIT_CONFIG_SYSTEM': os.devnull,\n    'GIT_TERMINAL_PROMPT': '0',\n})\n\ndef run_git(args, *, check=True, **kwargs):\n    return subprocess.run(\n        ['git', '-c', 'core.hooksPath=/dev/null', *args],\n        text=True,\n        check=check,\n        env=git_env,\n        **kwargs,\n    )\n\nrepo = os.environ.get('WORKSPACE_REPO', '').strip()\nif not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repo):\n    print('ERROR: Resolve must provide workspace_repo as owner/repo.', file=sys.stderr)\n    raise SystemExit(1)\n\nrun_git(['rev-parse', '--is-inside-work-tree'], stdout=subprocess.DEVNULL)\nbase = 'main'\nbranch = os.environ.get('BRANCH_NAME', '').strip()\nif not branch:\n    stamp = datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')\n    branch = 'resolve/implement-' + stamp\nif branch in {'main', base}:\n    print('ERROR: publication branch cannot be main or the base branch.', file=sys.stderr)\n    raise SystemExit(1)\nif not branch.startswith('resolve/implement-') or len(branch) == len('resolve/implement-'):\n    print('ERROR: branch_name must be under resolve/implement-*.', file=sys.stderr)\n    raise SystemExit(1)\nif run_git(['check-ref-format', '--branch', branch], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:\n    print('ERROR: invalid branch_name: %s' % branch, file=sys.stderr)\n    raise SystemExit(1)\n\nrun_git(['switch', '-C', branch])\nrun_git(['add', '-A'])\nrun_git(['reset', '--', '.ai'])\nstaged = run_git(['diff', '--cached', '--name-only'], stdout=subprocess.PIPE).stdout.splitlines()\nleaked = [path for path in staged if path == '.ai' or path.startswith('.ai/')]\nif leaked:\n    print('ERROR: .ai state remains staged: ' + ', '.join(leaked), file=sys.stderr)\n    raise SystemExit(1)\nif not staged:\n    print('ERROR: no tested repository changes are staged for commit.', file=sys.stderr)\n    raise SystemExit(1)\nrun_git([\n    '-c', 'user.email=resolve@local', '-c', 'user.name=Resolve',\n    'commit', '--no-verify', '-m', 'resolve: implement session-distilled task',\n])\ncommit = run_git(['rev-parse', 'HEAD'], stdout=subprocess.PIPE).stdout.strip()\nmetadata = {\n    'repo': repo,\n    'branch': branch,\n    'base': 'main',\n    'commit': commit,\n    'staged_files': staged,\n}\nwith open('.ai/implement/commit.json', 'w', encoding='utf-8') as handle:\n    json.dump(metadata, handle, indent=2)\n    handle.write(chr(10))\nprint('committed')\nPYEOF"
  ];

  Publish [
    shape=parallelogram,
    label="Publish GitHub PR",
    tool_env="workspace_repo",
    requires=".ai/implement/commit.json,.ai/implement/test-command.txt",
    timeout="300s",
    tool_command="#!/bin/sh\nset -eu\nmkdir -p .ai/implement\npython3 - <<'PYEOF'\nimport json\nimport os\nimport subprocess\nimport sys\n\ntarget_repo = os.environ.get('WORKSPACE_REPO', '').strip()\ntoken = os.environ.get('GH_TOKEN', '')\nif not token:\n    print('ERROR: GH_TOKEN is unavailable for GitHub publication.', file=sys.stderr)\n    raise SystemExit(1)\nwith open('.ai/implement/commit.json', encoding='utf-8') as handle:\n    commit_report = json.load(handle)\nexpected_commit_keys = {'repo', 'branch', 'base', 'commit', 'staged_files'}\nif not isinstance(commit_report, dict) or set(commit_report) != expected_commit_keys or not isinstance(commit_report.get('staged_files'), list):\n    print('ERROR: commit report schema is invalid or ambiguous.', file=sys.stderr)\n    raise SystemExit(1)\nbase_branch = 'main'\ngit_env = dict(os.environ)\ngit_env.update({\n    'GIT_CONFIG_GLOBAL': os.devnull,\n    'GIT_CONFIG_NOSYSTEM': '1',\n    'GIT_CONFIG_SYSTEM': os.devnull,\n    'GIT_TERMINAL_PROMPT': '0',\n})\n\ndef run(args, *, check=True, **kwargs):\n    return subprocess.run(args, text=True, check=check, env=git_env, **kwargs)\n\ndef run_git(args, **kwargs):\n    return run(['git', '-c', 'core.hooksPath=/dev/null', *args], **kwargs)\n\ndef gh_api(endpoint, *, method='GET', fields=None, check=True):\n    args = ['gh', 'api', '--method', method, endpoint]\n    for key, value in (fields or {}).items():\n        args.extend(['-f', '%s=%s' % (key, value)])\n    result = run(args, check=check, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n    if result.returncode != 0:\n        return None\n    try:\n        return json.loads(result.stdout)\n    except json.JSONDecodeError as error:\n        print('ERROR: GitHub API returned invalid JSON for %s: %s' % (endpoint, error), file=sys.stderr)\n        raise SystemExit(1)\n\ndef fork_is_valid(repo_data):\n    parent = (repo_data.get('parent') or {}).get('full_name')\n    source = (repo_data.get('source') or {}).get('full_name')\n    return repo_data.get('fork') is True and parent == target_repo and source == target_repo and (repo_data.get('permissions') or {}).get('push') is True\n\ndef validate_fork(repo_data):\n    if not isinstance(repo_data, dict) or not fork_is_valid(repo_data):\n        print('ERROR: authenticated-user repository is not a fork in the target network.', file=sys.stderr)\n        raise SystemExit(1)\n\ndef matching_prs(head_owner, head_branch):\n    result = gh_api(\n        'repos/%s/pulls' % target_repo,\n        fields={\n            'state': 'open',\n            'head': '%s:%s' % (head_owner, head_branch),\n            'base': base_branch,\n            'per_page': '100',\n        },\n    )\n    if not isinstance(result, list):\n        print('ERROR: GitHub pull request query returned an unexpected shape.', file=sys.stderr)\n        raise SystemExit(1)\n    return result\n\nlocal_branch = run_git(['symbolic-ref', '--short', 'HEAD'], stdout=subprocess.PIPE).stdout.strip()\nlocal_commit = run_git(['rev-parse', 'HEAD'], stdout=subprocess.PIPE).stdout.strip()\nif local_branch in {'main', base_branch} or not local_branch.startswith('resolve/implement-') or len(local_branch) == len('resolve/implement-'):\n    print('ERROR: current branch must be under resolve/implement-* and cannot be the base branch.', file=sys.stderr)\n    raise SystemExit(1)\nif commit_report.get('repo') != target_repo or commit_report.get('branch') != local_branch or commit_report.get('commit') != local_commit or commit_report.get('base') != base_branch:\n    print('ERROR: local Git state does not match commit reporting artifacts.', file=sys.stderr)\n    raise SystemExit(1)\nactor = gh_api('user')\ntarget = gh_api('repos/%s' % target_repo)\nif not isinstance(actor, dict) or not actor.get('login') or not isinstance(target, dict) or target.get('full_name') != target_repo:\n    print('ERROR: could not resolve authenticated user or target repository.', file=sys.stderr)\n    raise SystemExit(1)\nactor_login = actor['login']\npermissions = target.get('permissions') or {}\ncredential_helper = '!f() { echo username=x-access-token; echo password=$GH_TOKEN; }; f'\nif permissions.get('push') is True:\n    push_repo = target_repo\n    publication_mode = 'direct'\n    head_owner = target_repo.split('/', 1)[0]\nelse:\n    fork_repo = '%s/%s' % (actor_login, target_repo.split('/', 1)[1])\n    fork_url = 'https://github.com/%s.git' % fork_repo\n    fork = gh_api('repos/%s' % fork_repo, check=False)\n    if fork is None:\n        created = gh_api('repos/%s/forks' % target_repo, method='POST')\n        if not isinstance(created, dict):\n            print('ERROR: GitHub did not accept fork creation.', file=sys.stderr)\n            raise SystemExit(1)\n        import time\n        ready = False\n        for delay in (0, 1, 2, 4, 8, 12):\n            if delay:\n                time.sleep(delay)\n            fork = gh_api('repos/%s' % fork_repo, check=False)\n            if isinstance(fork, dict) and fork_is_valid(fork):\n                probe = run_git(\n                    ['-c', 'credential.helper=' + credential_helper, 'ls-remote', fork_url],\n                    check=False,\n                    stdout=subprocess.DEVNULL,\n                    stderr=subprocess.DEVNULL,\n                )\n                if probe.returncode == 0:\n                    ready = True\n                    break\n        if not ready:\n            print('ERROR: newly created fork did not become metadata-and-Git ready within bounded backoff.', file=sys.stderr)\n            raise SystemExit(1)\n    else:\n        validate_fork(fork)\n    push_repo = fork_repo\n    publication_mode = 'fork'\n    head_owner = actor_login\n\npush_url = 'https://github.com/%s.git' % push_repo\nrun_git(['-c', 'credential.helper=' + credential_helper, 'push', '--no-verify', push_url, 'HEAD:refs/heads/' + local_branch])\nremote = run_git(['-c', 'credential.helper=' + credential_helper, 'ls-remote', push_url, 'refs/heads/' + local_branch], stdout=subprocess.PIPE).stdout.strip().split()\nif not remote or remote[0] != local_commit:\n    print('ERROR: publication repository branch does not contain the tested commit.', file=sys.stderr)\n    raise SystemExit(1)\nwith open('.ai/implement/test-command.txt', encoding='utf-8') as handle:\n    test_command = handle.read().strip()\nbody = 'Implements the session-distilled task.' + chr(10) + chr(10) + 'Test command passed:' + chr(10) + '`' + test_command + '`' + chr(10)\nprs = matching_prs(head_owner, local_branch)\nif len(prs) > 1:\n    print('ERROR: multiple open pull requests match the publication head and base.', file=sys.stderr)\n    raise SystemExit(1)\nif not prs:\n    created_pr = gh_api(\n        'repos/%s/pulls' % target_repo,\n        method='POST',\n        fields={\n            'title': 'Implement session-distilled task',\n            'head': '%s:%s' % (head_owner, local_branch),\n            'base': base_branch,\n            'body': body,\n        },\n    )\n    if not isinstance(created_pr, dict):\n        print('ERROR: GitHub pull request creation failed.', file=sys.stderr)\n        raise SystemExit(1)\n    prs = matching_prs(head_owner, local_branch)\nif len(prs) != 1:\n    print('ERROR: expected exactly one open pull request after publication.', file=sys.stderr)\n    raise SystemExit(1)\npr = prs[0]\nhead = pr.get('head') or {}\nbase = pr.get('base') or {}\nif pr.get('state') != 'open' or (base.get('repo') or {}).get('full_name') != target_repo or base.get('ref') != base_branch or (head.get('repo') or {}).get('full_name') != push_repo or (head.get('repo') or {}).get('owner', {}).get('login') != head_owner or head.get('ref') != local_branch or head.get('sha') != local_commit or not isinstance(pr.get('number'), int) or not pr.get('html_url'):\n    print('ERROR: published pull request does not match the exact target, head, and commit.', file=sys.stderr)\n    raise SystemExit(1)\nreport = {\n    'target_repo': target_repo,\n    'push_repo': push_repo,\n    'publication_mode': publication_mode,\n    'head_owner': head_owner,\n    'head_branch': local_branch,\n    'base_branch': base_branch,\n    'commit': local_commit,\n    'pr_number': pr['number'],\n    'pr_url': pr['html_url'],\n}\nreport_path = '.ai/implement/delivery.json'\ntemporary_path = report_path + '.tmp-%s' % os.getpid()\nwith open(temporary_path, 'w', encoding='utf-8') as handle:\n    json.dump(report, handle, indent=2)\n    handle.write(chr(10))\n    handle.flush()\n    os.fsync(handle.fileno())\nos.replace(temporary_path, report_path)\nprint('published')\nPYEOF"
  ];

  VerifyPR [
    shape=parallelogram,
    label="Verify GitHub branch and PR",
    tool_env="workspace_repo",
    requires=".ai/implement/commit.json,.ai/implement/delivery.json",
    timeout="120s",
    tool_command="#!/bin/sh\nset -eu\npython3 - <<'PYEOF'\nimport json\nimport os\nimport subprocess\nimport sys\n\ntarget_repo = os.environ.get('WORKSPACE_REPO', '').strip()\nwith open('.ai/implement/commit.json', encoding='utf-8') as handle:\n    commit_report = json.load(handle)\nwith open('.ai/implement/delivery.json', encoding='utf-8') as handle:\n    delivery = json.load(handle)\nexpected_commit_keys = {'repo', 'branch', 'base', 'commit', 'staged_files'}\nif not isinstance(commit_report, dict) or set(commit_report) != expected_commit_keys or not isinstance(commit_report.get('staged_files'), list):\n    print('ERROR: commit report schema is invalid or ambiguous.', file=sys.stderr)\n    raise SystemExit(1)\nexpected_keys = {\n    'target_repo',\n    'push_repo',\n    'publication_mode',\n    'head_owner',\n    'head_branch',\n    'base_branch',\n    'commit',\n    'pr_number',\n    'pr_url',\n}\nif not isinstance(delivery, dict) or set(delivery) != expected_keys:\n    print('ERROR: delivery report schema is invalid or ambiguous.', file=sys.stderr)\n    raise SystemExit(1)\nfor key in expected_keys - {'pr_number'}:\n    if not isinstance(delivery.get(key), str) or not delivery[key]:\n        print('ERROR: delivery report field %s must be a non-empty string.' % key, file=sys.stderr)\n        raise SystemExit(1)\nif not isinstance(delivery.get('pr_number'), int) or delivery['pr_number'] <= 0:\n    print('ERROR: delivery report pr_number must be a positive integer.', file=sys.stderr)\n    raise SystemExit(1)\ngit_env = dict(os.environ)\ngit_env.update({\n    'GIT_CONFIG_GLOBAL': os.devnull,\n    'GIT_CONFIG_NOSYSTEM': '1',\n    'GIT_CONFIG_SYSTEM': os.devnull,\n    'GIT_TERMINAL_PROMPT': '0',\n})\n\ndef run(args, **kwargs):\n    return subprocess.run(args, text=True, check=True, env=git_env, **kwargs)\n\ndef run_git(args, **kwargs):\n    return run(['git', '-c', 'core.hooksPath=/dev/null', *args], **kwargs)\n\ndef gh_api(endpoint):\n    result = run(['gh', 'api', '--method', 'GET', endpoint], stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n    try:\n        return json.loads(result.stdout)\n    except json.JSONDecodeError as error:\n        print('ERROR: GitHub API returned invalid JSON for %s: %s' % (endpoint, error), file=sys.stderr)\n        raise SystemExit(1)\n\ndef validate_fork(repo_data):\n    parent = (repo_data.get('parent') or {}).get('full_name')\n    source = (repo_data.get('source') or {}).get('full_name')\n    if repo_data.get('fork') is not True or parent != target_repo or source != target_repo or (repo_data.get('permissions') or {}).get('push') is not True:\n        print('ERROR: push repository is not a writable fork in the target network.', file=sys.stderr)\n        raise SystemExit(1)\n\nlocal_branch = run_git(['symbolic-ref', '--short', 'HEAD'], stdout=subprocess.PIPE).stdout.strip()\nlocal_commit = run_git(['rev-parse', 'HEAD'], stdout=subprocess.PIPE).stdout.strip()\nif local_branch in {'main', delivery['base_branch']} or not local_branch.startswith('resolve/implement-') or len(local_branch) == len('resolve/implement-'):\n    print('ERROR: current branch must be under resolve/implement-* and cannot be the base branch.', file=sys.stderr)\n    raise SystemExit(1)\nif commit_report['repo'] != target_repo or commit_report['branch'] != local_branch or commit_report['commit'] != local_commit or commit_report['base'] != 'main' or delivery['target_repo'] != target_repo or delivery['head_branch'] != local_branch or delivery['commit'] != local_commit or delivery['base_branch'] != 'main':\n    print('ERROR: local Git state, commit report, and delivery report do not corroborate.', file=sys.stderr)\n    raise SystemExit(1)\nif delivery['publication_mode'] == 'direct':\n    if delivery['push_repo'] != target_repo or delivery['head_owner'] != target_repo.split('/', 1)[0]:\n        print('ERROR: direct publication report is internally inconsistent.', file=sys.stderr)\n        raise SystemExit(1)\nelif delivery['publication_mode'] == 'fork':\n    if delivery['push_repo'] == target_repo or delivery['head_owner'] != delivery['push_repo'].split('/', 1)[0]:\n        print('ERROR: fork publication report is internally inconsistent.', file=sys.stderr)\n        raise SystemExit(1)\n    validate_fork(gh_api('repos/%s' % delivery['push_repo']))\nelse:\n    print('ERROR: unknown publication_mode.', file=sys.stderr)\n    raise SystemExit(1)\npush_url = 'https://github.com/%s.git' % delivery['push_repo']\ncredential_helper = '!f() { echo username=x-access-token; echo password=$GH_TOKEN; }; f'\nremote = run_git(['-c', 'credential.helper=' + credential_helper, 'ls-remote', push_url, 'refs/heads/' + local_branch], stdout=subprocess.PIPE).stdout.strip().split()\nif not remote or remote[0] != local_commit:\n    print('ERROR: publication repository branch verification failed.', file=sys.stderr)\n    raise SystemExit(1)\npr = gh_api('repos/%s/pulls/%s' % (target_repo, delivery['pr_number']))\nhead = pr.get('head') or {}\nbase = pr.get('base') or {}\nexpected_url = 'https://github.com/%s/pull/%s' % (target_repo, delivery['pr_number'])\nif str(pr.get('state', '')).lower() != 'open' or (base.get('repo') or {}).get('full_name') != target_repo or base.get('ref') != delivery['base_branch'] or (head.get('repo') or {}).get('full_name') != delivery['push_repo'] or (head.get('repo') or {}).get('owner', {}).get('login') != delivery['head_owner'] or head.get('ref') != delivery['head_branch'] or head.get('sha') != local_commit or pr.get('html_url') != delivery['pr_url'] or delivery['pr_url'] != expected_url:\n    print('ERROR: target pull request does not exactly match delivery evidence.', file=sys.stderr)\n    raise SystemExit(1)\nprint(delivery['pr_url'])\nprint('verified')\nPYEOF"
  ];

  Start -> Implement;

  Implement -> Test [condition="outcome=success"];
  Implement -> FailLoud [condition="outcome=fail", label="implementation failed"];

  Test -> Review [condition="outcome=success"];
  Test -> FailLoud [condition="outcome=fail", label="tests failed"];

  Review -> Decide [condition="outcome=success"];
  Review -> FailLoud [condition="outcome=fail", label="review failed"];

  Decide -> Commit [condition="context.tool.last_line=review_pass && outcome=success", label="pass"];
  Decide -> Implement [condition="context.tool.last_line=repair && outcome=success", loop_restart=true, label="repair once"];
  Decide -> FailLoud [condition="context.tool.last_line=repair_exhausted && outcome=success", label="repair exhausted"];
  Decide -> FailLoud [condition="context.tool.last_line=review_invalid && outcome=success", label="invalid review"];
  Decide -> FailLoud [condition="outcome=fail", label="decision failed"];

  Commit -> Publish [condition="outcome=success"];
  Commit -> FailLoud [condition="outcome=fail", label="commit failed"];

  Publish -> VerifyPR [condition="outcome=success"];
  Publish -> FailLoud [condition="outcome=fail", label="publication failed"];

  VerifyPR -> Exit [condition="outcome=success"];
  VerifyPR -> FailLoud [condition="outcome=fail", label="verification failed"];
}