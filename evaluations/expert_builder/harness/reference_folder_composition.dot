// Evaluation-only composition harness for expert_builder reference bricks.
//
// The evaluation runner stages this file and the untouched package children
// together in a disposable target cwd:
//
//   reference_folder_composition.dot
//   references/prepare.dot
//   references/verify.dot
//
// Thus these folder nodes exercise real Attractor package-relative resolution,
// context cloning, and outputs= copy-up. `inject_mutation` is optional and
// accepts only `none` (the default) or `tracked`. A tracked mutation additionally
// requires `evaluation_fixture_root`; the selected reference must resolve strictly
// beneath that canonical evaluation-owned directory.

digraph reference_folder_composition {
  graph [
    label="Reference prepare/verify composition evaluation",
    labelloc="t",
    rankdir="LR",
    fontname="Helvetica",
    goal="Exercise real reference Prepare and Verify child graphs, their parent output contracts, and a deterministic tracked-file mutation.",
    default_max_retry="1",
    default_fidelity="truncate"
  ];
  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];

  // Shape vocabulary:
  // Mdiamond      = entry
  // folder        = real child DOT in cloned context
  // diamond       = exact parent-owned output contract
  // parallelogram = deterministic evaluation step or explicit failure
  // Msquare       = sole successful exit
  Start [shape=Mdiamond, label="Start"];
  Exit [shape=Msquare, label="Exit"];

  Prepare [
    shape=folder,
    label="Prepare references",
    dot_file="references/prepare.dot",
    outputs="reference_state,reference_manifest_digest"
  ];
  CheckPrepared [shape=diamond, label="reference_state = prepared?"];

  MutateBetweenChildren [
    shape=parallelogram,
    label="Inject deterministic mutation",
    tool_env="inject_mutation,evaluation_fixture_root",
    tool_command="#!/bin/sh\nset -eu\npython3 - <<'PYEOF'\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nmode = os.environ.get('INJECT_MUTATION', 'none').strip() or 'none'\nif mode not in {'none', 'tracked'}:\n    print('ERROR: inject_mutation must be none or tracked; got ' + repr(mode), file=sys.stderr)\n    raise SystemExit(1)\nif mode == 'none':\n    print(json.dumps({'mutation_class': 'none', 'mutation_path': None}, sort_keys=True, separators=(',', ':')))\n    raise SystemExit(0)\n\nfixture_root_raw = os.environ.get('EVALUATION_FIXTURE_ROOT', '').strip()\nif not fixture_root_raw:\n    print('ERROR: evaluation_fixture_root is required for inject_mutation=tracked', file=sys.stderr)\n    raise SystemExit(1)\ntry:\n    fixture_root = Path(fixture_root_raw).expanduser().resolve(strict=True)\n    if not fixture_root.is_dir():\n        raise RuntimeError('evaluation_fixture_root must be a directory')\nexcept (OSError, RuntimeError) as error:\n    print('ERROR: cannot canonicalize evaluation_fixture_root: ' + str(error), file=sys.stderr)\n    raise SystemExit(1)\n\nmanifest_path = Path('.ai/references.json')\ntry:\n    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))\nexcept (OSError, json.JSONDecodeError) as error:\n    print('ERROR: cannot read prepared reference manifest: ' + str(error), file=sys.stderr)\n    raise SystemExit(1)\nreferences = manifest.get('references') if isinstance(manifest, dict) else None\nif not isinstance(references, list) or not references:\n    print('ERROR: inject_mutation=tracked requires a prepared fixture-owned reference', file=sys.stderr)\n    raise SystemExit(1)\nfirst = references[0]\nif not isinstance(first, dict) or not isinstance(first.get('path'), str) or not first['path']:\n    print('ERROR: prepared manifest first reference has no usable path', file=sys.stderr)\n    raise SystemExit(1)\ntry:\n    root = Path(first['path']).resolve(strict=True)\n    if root == fixture_root or not root.is_relative_to(fixture_root):\n        raise RuntimeError('selected reference root must be strictly beneath evaluation_fixture_root')\n    tracked = root / 'tracked.txt'\n    if tracked.is_symlink() or not tracked.is_file():\n        raise RuntimeError('tracked.txt must be a real fixture-owned file')\n    if not tracked.resolve(strict=True).is_relative_to(root):\n        raise RuntimeError('tracked.txt escapes the first reference root')\nexcept (OSError, RuntimeError) as error:\n    print('ERROR: cannot select fixture-owned tracked.txt: ' + str(error), file=sys.stderr)\n    raise SystemExit(1)\ncheck = subprocess.run(\n    ['git', '-C', str(root), 'ls-files', '--error-unmatch', '--', 'tracked.txt'],\n    stdout=subprocess.PIPE,\n    stderr=subprocess.PIPE,\n    text=True,\n)\nif check.returncode:\n    print('ERROR: fixture-owned tracked.txt is not Git-tracked: ' + check.stderr.strip(), file=sys.stderr)\n    raise SystemExit(1)\nwith tracked.open('ab') as handle:\n    handle.write(bytes([10]) + b'evaluation injected tracked mutation' + bytes([10]))\nprint(json.dumps({'mutation_class': 'tracked', 'mutation_path': str(tracked.resolve(strict=True))}, sort_keys=True, separators=(',', ':')))\nPYEOF"
  ];

  Verify [
    shape=folder,
    label="Verify references",
    dot_file="references/verify.dot",
    outputs="reference_integrity_state"
  ];
  CheckUnchanged [shape=diamond, label="reference_integrity_state = unchanged?"];

  FailPrepareChild [
    shape=parallelogram,
    label="FAIL: Prepare child failed",
    runs_on="failure",
    tool_command="#!/bin/sh\necho 'Prepare child failed; inspect its nested run log.' >&2\nexit 1"
  ];
  FailPreparedOutput [
    shape=parallelogram,
    label="FAIL: Prepare output contract",
    tool_command="#!/bin/sh\necho 'reference_state was missing or was not exactly prepared.' >&2\nexit 1"
  ];
  FailMutation [
    shape=parallelogram,
    label="FAIL: mutation setup",
    runs_on="failure",
    tool_command="#!/bin/sh\necho 'Mutation setup failed; tracked mutation requires a reference strictly beneath evaluation_fixture_root.' >&2\nexit 1"
  ];
  FailVerifyChild [
    shape=parallelogram,
    label="FAIL: Verify child failed",
    runs_on="failure",
    tool_command="#!/bin/sh\necho 'Verify child failed; the evaluation runner must inspect the nested child status and diagnostics.' >&2\nexit 1"
  ];
  FailVerifyOutput [
    shape=parallelogram,
    label="FAIL: Verify output contract",
    tool_command="#!/bin/sh\necho 'reference_integrity_state was missing or was not exactly unchanged.' >&2\nexit 1"
  ];

  Start -> Prepare;
  Prepare -> CheckPrepared [condition="outcome=success"];
  Prepare -> FailPrepareChild [condition="outcome=fail", label="child failed"];

  CheckPrepared -> MutateBetweenChildren [
    condition="context.reference_state=prepared",
    label="prepared"
  ];
  CheckPrepared -> FailPreparedOutput [
    condition="context.reference_state!=prepared",
    label="missing or unexpected"
  ];

  MutateBetweenChildren -> Verify [condition="outcome=success"];
  MutateBetweenChildren -> FailMutation [condition="outcome=fail", label="mutation failed"];

  Verify -> CheckUnchanged [condition="outcome=success"];
  Verify -> FailVerifyChild [condition="outcome=fail", label="child failed"];

  CheckUnchanged -> Exit [
    condition="context.reference_integrity_state=unchanged",
    label="unchanged"
  ];
  CheckUnchanged -> FailVerifyOutput [
    condition="context.reference_integrity_state!=unchanged",
    label="missing or unexpected"
  ];
}